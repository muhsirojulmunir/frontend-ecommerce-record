# =====================================================================
#  Toko RECORD (recordshoes.com)
#
#  Salin jadi .env, lalu isi bagian yang bertanda ISI_INI.
#  Berkas ini TIDAK berisi rahasia dan aman ikut terunggah.
# =====================================================================

APP_NAME="RECORD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://recordshoes.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Basis data -------------------------------------------------------
# HARUS sama persis dengan yang dipakai Seller Center — keduanya membaca
# satu basis data yang sama.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ISI_INI_nama_database
DB_USERNAME=ISI_INI_pengguna_database
DB_PASSWORD=ISI_INI_sandi_database

# --- Sesi -------------------------------------------------------------
# Nama cookie dibedakan dari Seller Center. Keduanya berbagi induk domain
# yang sama, jadi nama yang sama membuat sesinya saling menimpa.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=recordshoes.com
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=record-toko-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Email ------------------------------------------------------------
# Dipakai untuk lupa kata sandi dan kabar pesanan. Isi dengan layanan
# pengirim sungguhan; Gmail biasa kena batas kirim dan sering masuk spam.
MAIL_MAILER=smtp
MAIL_HOST=ISI_INI_host_smtp
MAIL_PORT=587
MAIL_USERNAME=ISI_INI_pengguna_smtp
MAIL_PASSWORD=ISI_INI_sandi_smtp
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@recordshoes.com"
MAIL_FROM_NAME="RECORD"

# --- Gambar produk dari Seller Center ---------------------------------
# Toko membaca gambar produk langsung dari folder Seller Center. Kedua
# aplikasi WAJIB berada di satu server yang sama, dan jalur di bawah harus
# menunjuk folder storage/app/public milik Seller Center.
# Ganti USERNAME dengan nama pengguna cPanel-mu.
BACKEND_STORAGE_PATH=/home/USERNAME/admin/storage/app/public
BACKEND_STORAGE_URL=https://admin.recordshoes.com/storage

# --- Midtrans ---------------------------------------------------------
MIDTRANS_SERVER_KEY=ISI_INI_kunci_server_midtrans
MIDTRANS_CLIENT_KEY=ISI_INI_kunci_client_midtrans
MIDTRANS_IS_PRODUCTION=false

# --- Biteship ---------------------------------------------------------
BITESHIP_API_KEY=ISI_INI_kunci_biteship
BITESHIP_API_URL=https://api.biteship.com/v1

# --- Biaya & markup ---------------------------------------------------
MARKUP_ONGKIR_PERSEN=25

# --- Titik toko (asal pengiriman) -------------------------------------
STORE_CITY=Surabaya
STORE_LATITUDE=-7.2575
STORE_LONGITUDE=112.7521
